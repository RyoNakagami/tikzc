{
  "name": "tikzc-preview",
  "displayName": "TikZc Editor",
  "description": "Rust-native TikZ preview with canvas editing and identical SVG/PNG exports",
  "version": "1.0.0",
  "publisher": "RyoNak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyoNakagami/tikzc.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/RyoNakagami/tikzc/issues"
  },
  "homepage": "https://github.com/RyoNakagami/tikzc#readme",
  "icon": "images/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "tikz",
    "latex",
    "svg",
    "png",
    "diagram"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:tikz"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tikz",
        "aliases": [
          "TikZ"
        ],
        "extensions": [
          ".tikz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "tikzc.showPreview",
        "title": "TikZc Editor: Open to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "tikzc.exportSvg",
        "title": "TikZc Editor: Export as SVG"
      },
      {
        "command": "tikzc.exportPng",
        "title": "TikZc Editor: Export as PNG"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tikzc.showPreview",
          "when": "editorLangId == tikz",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tikzc.showPreview",
          "when": "editorLangId == tikz"
        },
        {
          "command": "tikzc.exportSvg",
          "when": "editorLangId == tikz"
        },
        {
          "command": "tikzc.exportPng",
          "when": "editorLangId == tikz"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tikzc.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == tikz"
      }
    ],
    "configuration": {
      "title": "TikZc Editor (tikzc)",
      "properties": {
        "tikzc.mainfont": {
          "type": "string",
          "default": "",
          "description": "Default label font for preview and export (empty = IPAexMincho; source headers override this setting)"
        },
        "tikzc.extraPackages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional packages for preview and export (must be supported by the Rust renderer)"
        },
        "tikzc.extraLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional TikZ libraries for preview and export (must be supported by the Rust renderer)"
        },
        "tikzc.pngDpi": {
          "type": "number",
          "default": 300,
          "description": "Resolution for PNG preview and export",
          "exclusiveMinimum": 0
        },
        "tikzc.language": {
          "type": "string",
          "enum": ["en", "ja"],
          "enumItemLabels": ["English", "日本語"],
          "default": "en",
          "description": "Language of the preview toolbar and messages. Also selectable from the preview toolbar."
        },
        "tikzc.debounceMs": {
          "type": "number",
          "default": 400,
          "description": "Delay after the last keystroke before recompiling the preview",
          "minimum": 0
        },
        "tikzc.nativePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the Rust-native tikzc executable. Empty uses tikzc on PATH (install it with cargo install)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js && esbuild webview/native-preview.ts --bundle --platform=browser --target=es2022 --outfile=dist/native-preview.js",
    "check": "tsc --noEmit && tsc -p webview/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "build:native": "cargo build --locked --release -p tikzc",
    "test:native": "tsx --test tests/rust-renderer.test.ts tests/preview-queue.test.ts tests/native-webview.test.ts tests/native-host.test.ts tests/native-editing.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  }
}
