\begin{tikzpicture}
  \foreach \r/\c/\v in {0/0/50,0/1/3,0/2/2,
                        1/0/4,1/1/40,1/2/6,
                        2/0/1,2/1/5,2/2/44} {
    \pgfmathsetmacro{\p}{\v*2}
    \fill[blue!\p!white] (\c,-\r) rectangle +(1,-1);
    \node at ({\c+0.5},{-\r-0.5}) {\v};
  }
  \draw (0,0) grid[step=1] (3,-3);
\end{tikzpicture}
