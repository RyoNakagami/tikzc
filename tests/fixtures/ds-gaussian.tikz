\begin{tikzpicture}
  \draw[->] (-3,0) -- (3.3,0) node[right] {$x$};
  \draw[->] (0,0) -- (0,1.3) node[above] {$p(x)$};
  \draw[thick,blue,domain=-3:3,samples=121,smooth]
    plot (\x,{2.5*exp(-(\x)*(\x)/2)/sqrt(2*pi)});
  \draw[red,domain=-3:3,samples=61]
    plot (\x,{1/(1+exp(-2*\x))});
  \draw[green!50!black,variable=\t,domain=0:2*pi,samples=50]
    plot ({cos(\t r)},{sin(\t r)});
\end{tikzpicture}
